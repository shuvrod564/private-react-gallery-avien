# ============================================================================
# Personal Image Gallery — Environment Variables
# ============================================================================
# Copy this file to `.env` (local dev) and configure the values there.
# NEVER commit `.env` — it is git-ignored.
#
# ⚠️ SECURITY: never put real credentials in this file or in access.md.
#    Both are committed to the repository.
#
# Groups:
#   VITE_*          → exposed to the browser (public, safe values only)
#   DATABASE_URL    → server-side only (Aiven PostgreSQL — the new database)
#   SUPABASE_*      → server-side only (legacy, while migration is in progress)
#   CLOUDINARY_*    → server-side only
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Database — AIVEN for PostgreSQL (server-side only, NEVER expose to browser)
# ----------------------------------------------------------------------------
# Aiven console → your PostgreSQL service → Connection information.
# Format:
#   postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
# Example:
#   postgres://avnadmin:xxxx@pg-1a2b3c4d-shuvrod564.l.aivencloud.com:12345/defaultdb?sslmode=require
DATABASE_URL=

# ----------------------------------------------------------------------------
# Frontend (public) — Cloudinary
# ----------------------------------------------------------------------------
# Dashboard → Account details → Cloud name. Safe to expose.
VITE_CLOUDINARY_CLOUD_NAME=
# Suggested destination folder for all uploads (optional).
VITE_CLOUDINARY_UPLOAD_FOLDER=personal-gallery

# ----------------------------------------------------------------------------
# Server-side (secret — NEVER expose to the browser)
# ----------------------------------------------------------------------------

# Cloudinary: Dashboard → Account details → API Key + API Secret (keep private).
# ⚠️ The previous key/secret were leaked in a public commit — regenerate them.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated email(s) allowed to become administrators.
# Used by `npm run create-admin` (scripts/create-admin.mjs).
ADMIN_EMAILS=

# JWT signing secret for the new API auth layer (POST /api/auth/login).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ----------------------------------------------------------------------------
# Legacy — Supabase (only while the migration to Aiven is in progress)
# ----------------------------------------------------------------------------
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# Local development only (not used by Vercel)
# ----------------------------------------------------------------------------
PORT=3001
